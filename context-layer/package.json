{
  "name": "@atlas/context-layer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./landingZones": {
      "types": "./src/landingZones/landingZones.ts",
      "import": "./src/landingZones/landingZones.ts"
    },
    "./mcp": {
      "types": "./src/mcp/server.ts",
      "import": "./src/mcp/server.ts"
    },
    "./devMocks": {
      "types": "./src/devMocks/index.ts",
      "import": "./src/devMocks/index.ts"
    }
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --exclude \"scripts/*.debug.test.ts\"",
    "validate:guidance": "vitest run guidanceFixture"
  },
  "dependencies": {
    "@atlas/logging": "workspace:*",
    "@atlas/schema": "workspace:*",
    "@aws-crypto/sha256-js": "5.2.0",
    "@aws-sdk/client-dynamodb": "3.1127.0",
    "@aws-sdk/credential-provider-node": "3.972.82",
    "@aws-sdk/lib-dynamodb": "3.1127.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@smithy/signature-v4": "5.7.3",
    "iovalkey": "0.4.0",
    "node-html-parser": "^9.0.4",
    "undici": "8.10.2",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.5.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}

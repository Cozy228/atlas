{
  "name": "@atlas/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev-ports.mjs",
    "dev:e2e": "pnpm run \"/^dev:(client|server:e2e)$/\"",
    "dev:client": "vite dev",
    "dev:server": "tsx watch server/hono/dev.ts | pino-pretty --colorize --singleLine --translateTime SYS:HH:MM:ss.l --ignore pid,hostname,name",
    "dev:server:e2e": "tsx server/hono/dev.ts",
    "build": "pnpm run build:clean && pnpm run gen:agent-skills && pnpm run build:client && pnpm run build:server && pnpm run build:assemble && pnpm run build:verify",
    "build:clean": "node scripts/clean-output.mjs",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:assemble": "node scripts/assemble-output.mjs",
    "build:verify": "node scripts/verify-output.mjs",
    "gen:agent-skills": "node scripts/gen-agent-skills-index.mjs",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "measure:availability-render": "vitest run scripts/measure-availability-render-cost.debug.test.tsx --reporter verbose",
    "preperf:lhci": "pnpm run build",
    "perf:lhci": "lhci autorun",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --exclude scripts/*.debug.test.tsx"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.76",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ai-sdk/react": "^4.0.96",
    "@atlas/context-layer": "workspace:*",
    "@atlas/logging": "workspace:*",
    "@atlas/schema": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-table": "^9.2.4",
    "ai": "^7.0.93",
    "aws-react-icons": "^3.3.0",
    "azure-react-icons": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "hono": "4.12.34",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "oxc-transform-react": "^0.145.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  }
}

{
  "name": "@atlas/portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm run build:clean && pnpm run gen:agent-skills && pnpm run build:client && pnpm run build:server && pnpm run build:assemble && pnpm run build:verify",
    "build:clean": "node scripts/clean-output.mjs",
    "build:client": "vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:assemble": "node scripts/assemble-output.mjs",
    "build:verify": "node scripts/verify-output.mjs",
    "gen:agent-skills": "node scripts/gen-agent-skills-index.mjs",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "measure:availability-render": "vitest run scripts/measure-availability-render-cost.debug.test.tsx --reporter verbose",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --exclude scripts/*.debug.test.tsx"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.40",
    "@ai-sdk/openai-compatible": "^3.0.20",
    "@ai-sdk/react": "^4.0.51",
    "@atlas/context-layer": "workspace:*",
    "@atlas/logging": "workspace:*",
    "@atlas/schema": "workspace:*",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-form": "^1.33.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.48",
    "aws-react-icons": "^3.3.0",
    "azure-react-icons": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "hono": "^4.12.34",
    "motion": "^12.43.0",
    "nanoid": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.6.0",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.2.3",
    "@seriousme/openapi-schema-validator": "^2.9.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.23",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "babel-plugin-react-compiler": "1.0.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}

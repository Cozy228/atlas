{
  "name": "atlas",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @atlas/portal dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate:guidance": "pnpm --filter @atlas/context-layer validate:guidance",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt",
      "oxlint --fix --vitest-plugin"
    ]
  },
  "packageManager": "pnpm@11.22.0"
}
